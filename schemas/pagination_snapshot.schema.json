{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeliosPaginationSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "snapshot_id", "project_id", "version", "input_hash", "created_at", "consolidation", "layout", "renderer", "coordinate_system", "artifacts", "document_page_count", "eligible_page_count", "pages"],
  "properties": {
    "schema": {"const": "helios_pagination_snapshot@1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "input_hash": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "minLength": 1},
    "consolidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "context_id", "production_set_hash", "text_artifact_id", "text_sha256", "manifest_artifact_id", "manifest_sha256", "writing_contract"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "context_id": {"type": "string", "minLength": 1},
        "production_set_hash": {"$ref": "#/$defs/sha256"},
        "text_artifact_id": {"type": "string", "minLength": 1},
        "text_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_artifact_id": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "writing_contract": {"$ref": "#/$defs/versionedContract"}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256", "chapter_boundary", "fonts"],
      "properties": {
        "id": {"const": "helios_pagination_layout"},
        "version": {"const": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "chapter_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chapter_units_start_new_page", "inject_visible_heading", "visible_heading_policy"],
          "properties": {
            "chapter_units_start_new_page": {"const": true},
            "inject_visible_heading": {"const": false},
            "visible_heading_policy": {"const": "source_only"}
          }
        },
        "fonts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/fontProvenance"}}
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "os_name", "os_release", "os_version", "machine", "python_version", "playwright_version", "pypdf_version", "chromium_executable_sha256", "engine", "paginator_version", "template_version", "pdf_canonicalization_version"],
      "properties": {
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "os_name": {"type": "string", "minLength": 1},
        "os_release": {"type": "string"},
        "os_version": {"type": "string"},
        "machine": {"type": "string"},
        "python_version": {"type": "string", "minLength": 1},
        "playwright_version": {"type": "string", "minLength": 1},
        "pypdf_version": {"type": "string", "minLength": 1},
        "chromium_executable_sha256": {"$ref": "#/$defs/sha256"},
        "engine": {"const": "chromium_explicit_dom_v1"},
        "paginator_version": {"const": 1},
        "template_version": {"const": 1},
        "pdf_canonicalization_version": {"const": 1}
      }
    },
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_offsets", "byte_offsets", "intervals", "source"],
      "properties": {
        "character_offsets": {"const": "unicode_code_points"},
        "byte_offsets": {"const": "utf8_bytes"},
        "intervals": {"const": "half_open"},
        "source": {"const": "exact_text_consolidation"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["html", "pdf"],
      "properties": {
        "html": {"$ref": "#/$defs/artifact"},
        "pdf": {"$ref": "#/$defs/artifact"}
      }
    },
    "document_page_count": {"type": "integer", "minimum": 1},
    "eligible_page_count": {"type": "integer", "minimum": 8},
    "pages": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "versionedContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fontProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "font_sha256", "license_sha256", "role"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "font_sha256": {"$ref": "#/$defs/sha256"},
        "license_sha256": {"$ref": "#/$defs/sha256"},
        "role": {"enum": ["sans", "serif"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "relative_path", "sha256"],
      "properties": {
        "artifact_type": {"enum": ["pagination_render_html", "pagination_pdf"]},
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_mm", "y_mm", "width_mm", "height_mm"],
      "properties": {
        "x_mm": {"type": "number", "minimum": 0},
        "y_mm": {"type": "number", "minimum": 0},
        "width_mm": {"type": "number", "exclusiveMinimum": 0},
        "height_mm": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "span_order", "artifact_id", "source_sha256", "global_char_start", "global_char_end", "global_byte_start", "global_byte_end", "unit_char_start", "unit_char_end", "unit_byte_start", "unit_byte_end"],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^(INTRO|CH0[1-8]_[AB]|CONCLUSION)$"},
        "span_order": {"type": "integer", "minimum": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "global_char_start": {"type": "integer", "minimum": 0},
        "global_char_end": {"type": "integer", "minimum": 1},
        "global_byte_start": {"type": "integer", "minimum": 0},
        "global_byte_end": {"type": "integer", "minimum": 1},
        "unit_char_start": {"type": "integer", "minimum": 0},
        "unit_char_end": {"type": "integer", "minimum": 1},
        "unit_byte_start": {"type": "integer", "minimum": 0},
        "unit_byte_end": {"type": "integer", "minimum": 1}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_id", "chapter_page_number", "document_page_number", "eligible", "eligible_page_number", "page_key", "page_source_sha256", "text_region", "unit_spans", "visual_slot"],
      "properties": {
        "chapter_id": {"type": ["string", "null"], "pattern": "^CH0[1-8]$"},
        "chapter_page_number": {"type": ["integer", "null"], "minimum": 1},
        "document_page_number": {"type": "integer", "minimum": 1},
        "eligible": {"type": "boolean"},
        "eligible_page_number": {"type": ["integer", "null"], "minimum": 1},
        "page_key": {"type": ["string", "null"], "pattern": "^CH0[1-8]-P[0-9]{3}$"},
        "page_source_sha256": {"$ref": "#/$defs/sha256"},
        "text_region": {"$ref": "#/$defs/box"},
        "unit_spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
        "visual_slot": {"oneOf": [{"$ref": "#/$defs/box"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"eligible": {"const": true}}},
          "then": {
            "properties": {
              "chapter_id": {"type": "string", "pattern": "^CH0[1-8]$"},
              "chapter_page_number": {"type": "integer", "minimum": 1},
              "eligible_page_number": {"type": "integer", "minimum": 1},
              "page_key": {"type": "string", "pattern": "^CH0[1-8]-P[0-9]{3}$"},
              "visual_slot": {"$ref": "#/$defs/box"}
            }
          },
          "else": {
            "properties": {
              "chapter_id": {"type": "null"},
              "chapter_page_number": {"type": "null"},
              "eligible_page_number": {"type": "null"},
              "page_key": {"type": "null"},
              "visual_slot": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
