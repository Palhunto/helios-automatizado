{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "editorial",
    "prompts",
    "runtime"
  ],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "slug"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discipline",
        "desired_structure"
      ],
      "properties": {
        "discipline": {
          "type": "string",
          "minLength": 1
        },
        "desired_structure": {
          "type": "string",
          "minLength": 1
        },
        "additional_materials": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "academic_planning",
        "writing",
        "visual_planning",
        "image_global_style"
      ],
      "properties": {
        "academic_planning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "writing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "visual_planning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "image_global_style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "google_docs_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "allow_api_fallback",
        "browser_automation_enabled"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 2
        },
        "allow_api_fallback": {
          "type": "boolean"
        },
        "browser_automation_enabled": {
          "type": "boolean"
        }
      }
    }
  }
}