{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helios_visual_plan@1",
  "title": "M4.1 VisualPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "pagination_snapshot_id", "consolidation_id", "prompt", "figures"],
  "properties": {
    "schema": { "const": "helios_visual_plan@1" },
    "project_id": { "type": "string", "minLength": 1 },
    "pagination_snapshot_id": { "type": "string", "minLength": 1 },
    "consolidation_id": { "type": "string", "minLength": 1 },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "const": "omega_visual_planning" },
        "version": { "const": 2 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "project_id", "visual_plan_id", "pagination_snapshot_id", "figure_order",
          "number", "name", "editorial_page", "section",
          "exact_position", "main_concept", "conceptual_synthesis", "justification",
          "objective", "visual_type", "complexity", "generation_prompt",
          "document_page_number", "eligible_page_number", "page_key", "chapter_id",
          "page_unit_ids", "editorial_sha256"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "project_id": { "type": "string", "minLength": 1 },
          "visual_plan_id": { "type": "string", "minLength": 1 },
          "pagination_snapshot_id": { "type": "string", "minLength": 1 },
          "figure_order": { "type": "integer", "minimum": 1 },
          "number": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "editorial_page": { "type": "string", "minLength": 1 },
          "section": { "type": "string", "minLength": 1 },
          "exact_position": { "type": "string", "minLength": 1 },
          "main_concept": { "type": "string", "minLength": 1 },
          "conceptual_synthesis": { "type": "string", "minLength": 1 },
          "justification": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "visual_type": { "type": "string", "minLength": 1 },
          "complexity": { "enum": ["Editorial direta", "Editorial estruturada", "Síntese conceitual"] },
          "generation_prompt": { "type": "string", "minLength": 1 },
          "document_page_number": { "type": "integer", "minimum": 1 },
          "eligible_page_number": { "type": "integer", "minimum": 1 },
          "page_key": { "type": "string", "pattern": "^CH0[1-8]-P[0-9]{3}$" },
          "chapter_id": { "type": "string", "pattern": "^CH0[1-8]$" },
          "page_unit_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "editorial_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
